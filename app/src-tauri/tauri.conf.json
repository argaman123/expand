{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Expand",
  "version": "1.2.0",
  "identifier": "io.github.argaman123.expand",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Expand",
        "width": 480,
        "height": 780,
        "minWidth": 440,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#151517"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBMzI4QTA2NUM4Mzc5NDAKUldSQWVZTmNCb295eXFOS052b09MMGhsS1paRG12SnZUVnlxUVpPdGt5REJEeExyRmpHNEhndjkK",
      "endpoints": [
        "https://github.com/argaman123/expand/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Expand",
    "shortDescription": "An extra display and a shared mouse, keyboard and clipboard between a Windows PC and a Mac",
    "longDescription": "Expand turns a window on your Windows PC into an extra display for your Mac, and lets one mouse, keyboard and clipboard work across both.",
    "category": "Utility",
    "copyright": "GPL-3.0-or-later",
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "files": {
        "MacOS/expand-display": "../../target/expand-display",
        "MacOS/expand-panel": "../../target/expand-panel"
      },
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  }
}
