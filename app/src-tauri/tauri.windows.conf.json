{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Expand",
        "width": 1240,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        },
        "theme": "Dark"
      }
    ]
  },
  "build": {
    "beforeBundleCommand": "cargo build -p expand_viewer_hook --release"
  }
}
